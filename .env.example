# Скопируйте в .env и поправьте под себя. docker compose подхватит его автоматически.

# ---------- Камеры ----------
# Формат "id:ip,id:ip,id:ip" (можно через ;)
CHAMBERS=1:192.168.1.106,2:192.168.1.252,3:192.168.0.45

# Названия камер: "id:название" через точку с запятой
CHAMBER_NAMES=1:Terchy MHX-408NK 2021;2:Terchy MHX-408NK 2023;3:Terchy MHX-225NK

UDP_PORT=5001
START_REGISTER=101
REGISTER_COUNT=18

# Индексы регистров внутри прочитанного блока (0 = первый). -1 = не читать.
# Когда узнаете регистры влажности и уставок — пропишите их здесь,
# на сайте автоматически появятся графики и пороги влажности.
TEMPERATURE_REGISTER_INDEX=0
HUMIDITY_REGISTER_INDEX=-1
TARGET_TEMPERATURE_REGISTER_INDEX=1
TARGET_HUMIDITY_REGISTER_INDEX=-1
REGISTER_SCALE=100

POLL_INTERVAL_MS=1000
SOCKET_TIMEOUT=2.0
# Сколько неудачных опросов подряд = "камера отключилась"
OFFLINE_AFTER_FAILURES=3

GRAPH_POINTS=600
TIMEZONE=Europe/Moscow

# При запуске без Docker укажите localhost вместо db
DATABASE_URL=postgresql+asyncpg://climatica:climatica@db:5432/climatica

# ---------- Пороги по умолчанию (для новых камер) ----------
DEFAULT_TEMPERATURE_MIN=2.0
DEFAULT_TEMPERATURE_MAX=8.0
DEFAULT_HUMIDITY_MIN=30
DEFAULT_HUMIDITY_MAX=70
THRESHOLD_HYSTERESIS=0.2

# ---------- Алерты / Telegram ----------
# Адрес бота для backend. Пусто = не слать в Telegram (журнал и браузер работают)
TELEGRAM_BOT_INTERNAL_URL=http://telegram-bot:8090
# Общий секрет backend <-> бот (любая строка, одинаковая у обоих). Можно оставить пустым.
INTERNAL_API_TOKEN=
ALERT_RETRY_INTERVAL=30
ALERT_MAX_ATTEMPTS=10

# Для контейнера telegram-bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_PROXY_URL=

# Брать IP из X-Forwarded-For (только если перед сайтом стоит nginx/другой proxy)
TRUST_PROXY_HEADERS=false
