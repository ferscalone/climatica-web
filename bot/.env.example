# Используется при запуске бота без Docker (python -m bot.main из корня проекта).
# В Docker те же переменные задаются в docker-compose.yml / корневом .env.

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Кому слать уведомления: chat_id через запятую.
# Свой chat_id бот покажет в ответ на /start.
TELEGRAM_CHAT_IDS=

# Необязательно: прокси для доступа к api.telegram.org
TELEGRAM_PROXY_URL=

BOT_HTTP_HOST=0.0.0.0
BOT_HTTP_PORT=8090
# Должен совпадать с INTERNAL_API_TOKEN у backend (или оба пустые)
INTERNAL_API_TOKEN=

BACKEND_URL=http://localhost:8000
TIMEZONE=Europe/Moscow
